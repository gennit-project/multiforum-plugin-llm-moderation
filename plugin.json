{
  "id": "llm-moderation",
  "name": "LLM Moderation",
  "version": "0.8.0",
  "description": "Experimental report-only moderation using an external LLM service",
  "entry": "dist/index.js",
  "events": ["comment.created", "comment.edited", "discussionChannel.created", "discussionChannel.edited"],
  "secrets": [
    {
      "key": "MODERATION_SERVICE_API_KEY",
      "scope": "server",
      "required": true,
      "description": "Shared secret used to authenticate to the moderation service"
    }
  ],
  "settingsDefaults": {
    "server": {
      "serviceUrl": "",
      "model": "gpt-4o-mini",
      "temperature": 0,
      "maxTokens": 800,
      "confidenceThreshold": 0.7,
      "serviceTimeoutMs": 30000,
      "botName": "llm-moderator"
    },
    "channel": {}
  },
  "ui": {
    "forms": {
      "server": [
        {
          "title": "Moderation service",
          "fields": [
            { "type": "text", "key": "serviceUrl", "label": "Service URL", "required": true },
            {
              "type": "select",
              "key": "serverRuleEnforcement",
              "label": "Server-rule enforcement",
              "description": "Choose all, no, or allowlisted forums for mandatory server rules. Forum eligibility and owner choices do not change this scope.",
              "options": [
                { "label": "Off", "value": "off" },
                { "label": "All forums", "value": "on" },
                { "label": "Allowlisted forums", "value": "allowlist" }
              ]
            },
            {
              "type": "forum-multiselect",
              "key": "serverRuleForumAllowlist",
              "label": "Forums subject to server rules",
              "description": "Independent of forum-rule eligibility. Empty means no forums.",
              "visibleWhen": { "key": "serverRuleEnforcement", "equals": "allowlist" }
            },
            {
              "type": "select",
              "key": "channelRuleEligibility",
              "label": "Channel-rule eligibility",
              "description": "Choose which forum owners may opt into checking their own forum rules. Eligibility does not enable enforcement automatically. Defaults to all forums.",
              "options": [
                { "label": "All forums", "value": "all" },
                { "label": "No forums", "value": "none" },
                { "label": "Allowlisted forums", "value": "allowlist" }
              ]
            },
            {
              "type": "forum-multiselect",
              "key": "channelRuleAllowlist",
              "label": "Forums eligible for channel-rule enforcement",
              "description": "Owners of these forums may opt into enforcing their forum rules. An empty list permits no forums. This does not affect server rules.",
              "placeholder": "Select forums...",
              "visibleWhen": { "key": "channelRuleEligibility", "equals": "allowlist" }
            },
            { "type": "number", "key": "confidenceThreshold", "label": "Confidence threshold", "min": 0, "max": 1, "step": 0.05 }
          ]
        }
      ],
      "channel": []
    }
  },
  "metadata": {
    "author": { "name": "Multiforum Team", "url": "https://github.com/gennit-project" },
    "homepage": "https://github.com/gennit-project/multiforum-plugin-llm-moderation",
    "license": "MIT",
    "tags": ["moderation", "ai", "experimental", "bot"]
  },
  "documentation": { "readmePath": "README.md" },
  "source": {
    "repoUrl": "https://github.com/gennit-project/multiforum-plugin-llm-moderation",
    "releaseNotesUrl": "https://github.com/gennit-project/multiforum-plugin-llm-moderation/releases/tag/v0.8.0"
  },
  "compatibility": { "minServerVersion": "1.0.0", "apiVersion": "1" }
}
