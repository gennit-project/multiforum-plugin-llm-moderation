{
  "id": "llm-moderation",
  "name": "LLM Moderation",
  "version": "0.7.0",
  "description": "Experimental report-only moderation using an external LLM service",
  "entry": "dist/index.js",
  "events": ["comment.created", "comment.edited", "discussionChannel.created", "discussionChannel.edited"],
  "secrets": [
    {
      "key": "MODERATION_SERVICE_API_KEY",
      "scope": "server",
      "required": true,
      "description": "Shared secret used to authenticate to the moderation service"
    }
  ],
  "settingsDefaults": {
    "server": {
      "serviceUrl": "",
      "serverRuleCheckMode": "off",
      "serverRuleForumAllowlist": [],
      "model": "gpt-4o-mini",
      "temperature": 0,
      "maxTokens": 800,
      "confidenceThreshold": 0.7,
      "serviceTimeoutMs": 30000,
      "botName": "llm-moderator"
    },
    "channel": {}
  },
  "ui": {
    "forms": {
      "server": [
        {
          "title": "Moderation service",
          "fields": [
            { "type": "text", "key": "serviceUrl", "label": "Service URL", "required": true },
            { "type": "secret", "key": "MODERATION_SERVICE_API_KEY", "label": "Service API key", "required": true },
            {
              "type": "select",
              "key": "serverRuleCheckMode",
              "label": "Server rule checking",
              "description": "Choose where the server-wide rules are evaluated. Forum-specific rules are enabled separately in each forum.",
              "options": [
                { "label": "Off", "value": "off" },
                { "label": "All forums", "value": "all_forums" },
                { "label": "Selected forums", "value": "allowlist" }
              ]
            },
            {
              "type": "forum-multiselect",
              "key": "serverRuleForumAllowlist",
              "label": "Forums checked against server rules",
              "description": "Only the selected forums are evaluated against server-wide rules.",
              "placeholder": "Select forums...",
              "required": true,
              "visibleWhen": { "key": "serverRuleCheckMode", "equals": "allowlist" }
            },
            { "type": "number", "key": "confidenceThreshold", "label": "Confidence threshold", "min": 0, "max": 1, "step": 0.05 }
          ]
        }
      ],
      "channel": []
    }
  },
  "metadata": {
    "author": { "name": "Multiforum Team", "url": "https://github.com/gennit-project" },
    "homepage": "https://github.com/gennit-project/multiforum-plugin-llm-moderation",
    "license": "MIT",
    "tags": ["moderation", "ai", "experimental", "bot"]
  },
  "documentation": { "readmePath": "README.md" },
  "source": {
    "repoUrl": "https://github.com/gennit-project/multiforum-plugin-llm-moderation",
    "releaseNotesUrl": "https://github.com/gennit-project/multiforum-plugin-llm-moderation/releases/tag/v0.7.0"
  },
  "compatibility": { "minServerVersion": "1.0.0", "apiVersion": "1" }
}
